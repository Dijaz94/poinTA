datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../server/generated"
}

model User {
  id       String    @id @default(uuid())
  name     String
  email    String    @unique
  subjects Subject[]
}

model Subject {
  id            String         @id @default(uuid())
  name          String
  code          String?
  semester      String
  users         User[]
  announcements Announcement[]
  materials     Material[]
  sessions      Session[]
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
}

model Material {
  id          String   @id @default(uuid())
  title       String
  description String?
  fileUrl     String
  createdAt   DateTime @default(now())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
}

model Session {
  id          String    @id @default(uuid())
  title       String
  isRecurring Boolean   @default(true)
  dayOfWeek   String?
  date        DateTime?
  startTime   String
  endTime     String
  location    String?
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
}
