generator client {
  provider = "prisma-client"
  output   = "../server/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String    @id @default(uuid())
  name     String
  email    String    @unique
  role     Role      @default(TA)
  isActive Boolean   @default(true)
  subjects Subject[] @relation("SubjectToUser")

  @@index([id])
}

model Subject {
  id            String         @id @default(uuid())
  name          String
  code          String?
  semester      String
  announcements Announcement[]
  materials     Material[]
  sessions      Session[]
  units         Unit[]
  users         User[]         @relation("SubjectToUser")

  @@index([id])
}

model Announcement {
  id               String           @id @default(uuid())
  title            String
  content          String           @default("")
  createdAt        DateTime         @default(now())
  subjectId        String
  authorizedEmails String[]
  deadline         DateTime?
  type             AnnouncementType @default(COMMUNICATION)
  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  options          PollOption[]

  @@index([id])
}

model PollOption {
  id             String       @id @default(uuid())
  label          String
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  votes          Vote[]

  @@index([id])
}

model Vote {
  id        String     @id @default(uuid())
  email     String
  optionId  String
  createdAt DateTime   @default(now())
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([email, optionId])
  @@index([id])
}

model Unit {
  id        String     @id @default(uuid())
  name      String
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  subjectId String
  parentId  String?
  materials Material[]
  parent    Unit?      @relation("UnitHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Unit[]     @relation("UnitHierarchy")
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([id])
}

model Material {
  id          String   @id @default(uuid())
  title       String
  description String?
  fileUrl     String
  createdAt   DateTime @default(now())
  subjectId   String
  unitId      String?
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unit        Unit?    @relation(fields: [unitId], references: [id])

  @@index([id])
}

model Session {
  id          String     @id @default(uuid())
  title       String
  isRecurring Boolean    @default(true)
  date        DateTime?
  startTime   String
  endTime     String
  location    String?
  subjectId   String
  dayOfWeek   DayOfWeek?
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([id])
}

enum Role {
  ADMIN
  TA
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AnnouncementType {
  COMMUNICATION
  POLL
}
