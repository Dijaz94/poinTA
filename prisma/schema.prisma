datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../server/generated"
}

enum Role {
  ADMIN
  TA
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id       String    @id @default(uuid())
  name     String
  email    String    @unique
  role     Role      @default(TA)
  isActive Boolean   @default(true)
  subjects Subject[]
}

model Subject {
  id            String         @id @default(uuid())
  name          String
  code          String?
  semester      String
  users         User[]
  announcements Announcement[]
  materials     Material[]
  sessions      Session[]
}

enum AnnouncementType {
  COMMUNICATION
  POLL
}

model Announcement {
  id               String           @id @default(uuid())
  title            String
  content          String           @default("")
  type             AnnouncementType @default(COMMUNICATION)
  deadline         DateTime?
  authorizedEmails String[]
  createdAt        DateTime         @default(now())
  subjectId        String
  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  options          PollOption[]
}

model PollOption {
  id             String       @id @default(uuid())
  label          String
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  votes          Vote[]
}

model Vote {
  id        String     @id @default(uuid())
  email     String
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([email, optionId])
}

model Material {
  id          String   @id @default(uuid())
  title       String
  description String?
  fileUrl     String
  createdAt   DateTime @default(now())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Session {
  id          String     @id @default(uuid())
  title       String
  isRecurring Boolean    @default(true)
  dayOfWeek   DayOfWeek?
  date        DateTime?
  startTime   String
  endTime     String
  location    String?
  subjectId   String
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}