# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key

# Service role (for creating Auth users from the app)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL (direct connection for Prisma)
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# Admin emails (comma-separated). Users with these emails get ADMIN role on first login.
ADMIN_EMAILS=tu@correo.cl
